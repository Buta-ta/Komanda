// Komanda — schéma Prisma
// Base : Supabase PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// CATALOGUE
// ============================================================

enum ProductType {
  BASE
  SUPPLEMENT
  PACK
  AGENT
  APP
  TEMPLATE
  AUDIT
  STUDIO
}

enum PriceType {
  ONCE
  MONTHLY
  YEARLY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TemplateKind {
  HTML
  NEXTJS
  SCREENSHOT
  FIGMA
}

model Product {
  id     String        @id @default(cuid())
  type   ProductType
  status ProductStatus @default(DRAFT)
  order  Int           @default(0)

  // Identifiants
  slug       String    @unique
  emoji      String?
  coverUrl   String?
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  // Bilingue
  nameFr        String
  nameEn        String?
  taglineFr     String?
  taglineEn     String?
  descriptionFr String?  @db.Text
  descriptionEn String?  @db.Text
  featuresFr    String[] @default([])
  featuresEn    String[] @default([])

  // Prix
  price              Int       @default(0)
  priceType          PriceType @default(ONCE)
  currency           String    @default("XOF")
  revisionsIncluded  Int       @default(1)
  extraRevisionPrice Int       @default(5000)

  // Template
  templateKind    TemplateKind?
  templateUrl     String?
  templateFileUrl String?
  priceBuild      Int?
  priceCode       Int?
  themeJson       Json?

  // Analytics
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  packItems     PackItem[]         @relation("PackContents")
  itemsInPack   PackItem[]         @relation("PackItems")
  orderItems    OrderItem[]
  projects      Project[]
  subscriptions Subscription[]
  categories    ProductCategory[]
  tags          ProductTag[]
  groups        ProductGroupItem[]

  @@index([type, status])
  @@index([slug])
}

model PackItem {
  id       String  @id @default(cuid())
  pack     Product @relation("PackContents", fields: [packId], references: [id], onDelete: Cascade)
  packId   String
  item     Product @relation("PackItems", fields: [itemId], references: [id])
  itemId   String
  quantity Int     @default(1)

  @@unique([packId, itemId])
}

// ============================================================
// CATÉGORIES (arborescentes)
// ============================================================

model Category {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameFr String
  nameEn String?
  emoji  String?
  color  String?
  order  Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  parentId String?
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productCategories ProductCategory[]
}

// ============================================================
// TAGS
// ============================================================

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  labelFr  String
  labelEn  String?
  emoji    String?
  color    String?
  products ProductTag[]

  createdAt DateTime @default(now())
}

model ProductTag {
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String

  @@id([productId, tagId])
}

model ProductCategory {
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([productId, categoryId])
}

// ============================================================
// GROUPES / COLLECTIONS
// ============================================================

model ProductGroup {
  id        String             @id @default(cuid())
  slug      String             @unique
  nameFr    String
  nameEn    String?
  emoji     String?
  order     Int                @default(0)
  visible   Boolean            @default(false)
  products  ProductGroupItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ProductGroupItem {
  group     ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  position  Int          @default(0)

  @@id([groupId, productId])
}

// ============================================================
// CLIENTS & AUTH
// ============================================================

model Customer {
  id        String   @id
  email     String?  @unique
  phone     String?  @unique
  fullName  String?
  company   String?
  country   String?
  city      String?
  avatarUrl String?
  isGuest   Boolean  @default(false)
  isAdmin   Boolean  @default(false)
  locale    String   @default("fr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  subscriptions Subscription[]
  invoices      Invoice[]
  conversations Conversation[]
  messages      Message[]
}

// ============================================================
// COMMANDES
// ============================================================

enum OrderStatus {
  PENDING_PAYMENT
  ONBOARDING
  IN_PRODUCTION
  PREVIEW_READY
  AWAITING_PAYMENT
  PAID
  IN_REVIEW
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique
  customer   Customer?   @relation(fields: [customerId], references: [id])
  customerId String?
  guestEmail String?
  guestPhone String?
  guestName  String?
  country    String?
  status     OrderStatus @default(ONBOARDING)
  currency   String      @default("XOF")

  onceTotal      Int @default(0)
  monthlyTotal   Int @default(0)
  yearlyTotal    Int @default(0)
  extraRevisions Int @default(0)
  discountTotal  Int @default(0)
  total          Int @default(0)

  notes      String? @db.Text
  adminNotes String? @db.Text
  utmSource  String?

  previewUrl     String?
  previewMessage String?
  previewSentAt  DateTime?
  paidAt         DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  payments      Payment[]
  invoices      Invoice[]
  subscription  Subscription?
  timeline      OrderEvent[]
  conversations Conversation[]
}

model OrderItem {
  id            String    @id @default(cuid())
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  product       Product   @relation(fields: [productId], references: [id])
  productId     String
  label         String
  description   String?
  unitPrice     Int
  quantity      Int       @default(1)
  priceType     PriceType
  variant       String? // "build" | "code"
  customization Json?
  revisionsUsed Int       @default(0)
  periodStart   DateTime?
  periodEnd     DateTime?
}

model OrderEvent {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  message   String?
  authorId  String?
  createdAt DateTime    @default(now())
}

// ============================================================
// PAIEMENTS
// ============================================================

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ORANGE
  MTN
  MOOV
  WAVE
  CARD
  BANK
  OTHER
}

model Payment {
  id              String         @id @default(cuid())
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  provider        String         @default("fedapay")
  providerRef     String?        @unique
  status          PaymentStatus  @default(PENDING)
  method          PaymentMethod?
  amount          Int
  currency        String         @default("XOF")
  fees            Int            @default(0)
  reason          String? // "order" | "extra_revision"
  callbackPayload Json?
  createdAt       DateTime       @default(now())
  paidAt          DateTime?
}

// ============================================================
// FACTURES
// ============================================================

model Invoice {
  id         String    @id @default(cuid())
  number     String    @unique
  order      Order     @relation(fields: [orderId], references: [id])
  orderId    String
  customer   Customer  @relation(fields: [customerId], references: [id])
  customerId String
  amount     Int
  currency   String    @default("XOF")
  pdfUrl     String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
}

// ============================================================
// ABONNEMENTS
// ============================================================

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id          String    @id @default(cuid())
  customer    Customer  @relation(fields: [customerId], references: [id])
  customerId  String
  order       Order?    @relation(fields: [orderId], references: [id])
  orderId     String?   @unique
  product     Product   @relation(fields: [productId], references: [id])
  productId   String
  status      SubStatus @default(ACTIVE)
  amount      Int
  interval    PriceType @default(MONTHLY)
  startDate   DateTime  @default(now())
  nextRenewal DateTime
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================================
// CONVERSATIONS / MESSAGERIE
// ============================================================

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model Conversation {
  id            String             @id @default(cuid())
  order         Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       String?            @unique
  customer      Customer           @relation(fields: [customerId], references: [id])
  customerId    String
  subject       String             @default("Commande")
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  messages      Message[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  author         Customer?    @relation(fields: [authorId], references: [id])
  authorId       String? // null = admin
  fromAdmin      Boolean      @default(false)
  body           String       @db.Text
  attachments    String[]     @default([])
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}

// ============================================================
// SHOWROOM
// ============================================================

model Project {
  id          String   @id @default(cuid())
  title       String
  client      String?
  sector      String?
  country     String?
  category    String?
  year        Int
  coverUrl    String?
  gallery     String[] @default([])
  link        String?
  description String?  @db.Text
  tags        String[] @default([])
  featured    Boolean  @default(false)
  order       Int      @default(0)
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// CONSEILLER (alertes)
// ============================================================

enum AdviceLevel {
  INFO
  WARNING
  DANGER
}

model Advice {
  id         String      @id @default(cuid())
  level      AdviceLevel @default(INFO)
  code       String      @unique
  message    String
  href       String?
  resolved   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
}

// ============================================================
// PARAMÈTRES
// ============================================================

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
